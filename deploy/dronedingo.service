[Unit]
Description=DroneDingo airspace monitoring appliance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dronedingo
WorkingDirectory=/opt/dronedingo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dronedingo/.venv/bin/uvicorn app.main:app \
  --host 0.0.0.0 --port 8000 --app-dir /opt/dronedingo/backend
Restart=always
RestartSec=3
# Allow raw sockets for capture sources (scapy) without full root:
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
