# The DroneDingo relay database lives here (inside the web root because shared
# hosting can't write above public_html). Block ALL web access to it — Apache
# 2.4 and 2.2 forms so it works either way.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
