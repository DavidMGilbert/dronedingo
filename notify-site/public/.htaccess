# notify.dronedingo.com.au — Apache config.
# The service worker must control the whole origin, so keep it at the root.

# Serve the PHP registration page for "/". It injects the per-registration
# manifest link server-side (see index.php) so Add-to-Home-Screen keeps node/t/k.
DirectoryIndex index.php index.html

# Never cache the service worker or the app shell (so updates land immediately).
<FilesMatch "^(sw\.js|app\.js|index\.php|index\.html)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Block direct access to the shared include files.
<FilesMatch "^_(config|db)\.php$">
  Require all denied
</FilesMatch>

# Correct MIME for the web app manifest.
AddType application/manifest+json .webmanifest
